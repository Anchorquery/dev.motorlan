{#
  Skeleton (carga). Útil como contenido inicial de un hx-get="…" hx-trigger="load".
    {% import 'components/skeleton.twig' as sk %}
    {{ sk.lines(3) }} · {{ sk.card() }} · {{ sk.table(5, 4) }} · {{ sk.block('h-40 w-full') }}
#}
{% macro block(class = 'h-4 w-full') -%}
<span class="ml-skeleton {{ class }}" aria-hidden="true"></span>
{%- endmacro %}

{% macro lines(count = 3) -%}
<div class="flex flex-col gap-2.5" aria-busy="true">
  {%- for i in 1..count %}<span class="ml-skeleton h-3.5 {{ loop.last ? 'w-3/5' : 'w-full' }}"></span>{% endfor -%}
</div>
{%- endmacro %}

{% macro card() -%}
<div class="ml-card" aria-busy="true">
  <span class="ml-skeleton block h-44 !rounded-none"></span>
  <div class="ml-card__body flex flex-col gap-3">
    <span class="ml-skeleton h-5 w-4/5"></span>
    <span class="ml-skeleton h-3.5 w-1/2"></span>
    <span class="ml-skeleton mt-2 h-6 w-1/3"></span>
  </div>
</div>
{%- endmacro %}

{% macro table(rows = 5, cols = 4) -%}
<div class="flex flex-col" aria-busy="true">
  {%- for r in 1..rows %}
  <div class="flex items-center gap-4 border-b border-border px-4 py-4 last:border-0">
    {%- for c in 1..cols %}<span class="ml-skeleton h-3.5 {{ c == 1 ? 'w-2/5' : 'flex-1' }}"></span>{% endfor -%}
  </div>
  {%- endfor %}
</div>
{%- endmacro %}
