{% extends 'layout/public.twig' %}
{#
  Ficha de producto: /marketplace-motorlan/{slug}/ (TiendaController::product).
  Datos: product (Support\Store::product) · favorite (null|bool) · related · chat · store_url.
  El SEO (title, canonical, JSON-LD Product…) se añade en wp_head antes de pintar (ver Support\Seo).
#}
{% block main %}
{%- import 'components/icon.twig' as ui -%}
{%- import 'components/alert.twig' as al -%}
{%- import 'components/avatar.twig' as av -%}
{%- import 'components/btn.twig' as b -%}
{%- set p = product -%}
<article class="ml-ficha" x-data="mlProductChat({{ ml_json(chat)|e('html_attr') }})">
  {# Enlace del email caducado (?ct= con token vencido): lo detecta product-chat.js. #}
  <div x-show="tokenExpired" x-cloak class="mb-4">
    {{ al.alert({ color: 'warning', closable: true, title: __('Enlace caducado', 'motorlan-portal'), text: __('El enlace del email ha caducado (válido 7 días). Para retomar la conversación, escribe un nuevo mensaje desde el chat del producto usando el mismo correo.', 'motorlan-portal') }) }}
  </div>
  {%- if not p.available and not p.owner %}
  <div class="mb-4">{{ al.alert({ color: 'info', text: __('Este artículo ya no está disponible: se ha vendido o el vendedor lo ha retirado temporalmente.', 'motorlan-portal') }) }}</div>
  {%- endif %}

  <h1 class="ml-ficha__title">{{ p.title|e }}</h1>

  <div class="ml-ficha__top">
    {# ── Galería (ProductImage.vue) ── #}
    {% include 'partials/ficha/galeria.twig' %}

    {# ── Detalle (ProductDetails.vue) ── #}
    <div class="min-w-0">
      <div class="ml-ficha__links">
        {%- if favorite is not null %}
          {% include 'partials/ficha-favorito.twig' with { product_id: p.id, favorite: favorite } only %}
        {%- endif %}
        <button type="button" class="ml-ficha__link" @click="$dispatch('ml-dialog', 'ml-share')">{{ ui.icon('share') }}<span>{{ __('Compartir', 'motorlan-portal')|e }}</span></button>
      </div>

      {% include 'partials/ficha/detalle.twig' %}

      {%- if p.description %}
      {# Ya saneada con wp_kses_post (Store::product). #}
      <div class="ml-richtext">{{ p.description|raw }}</div>
      {%- endif %}

      {%- if p.actions %}
      <div class="mb-6">
        <button type="button" class="ml-btn ml-btn--filled ml-c-error ml-btn--block capitalize" @click="openChat()" x-text="requested ? {{ ml_json(__('Abrir chat', 'motorlan-portal'))|e('html_attr') }} : {{ ml_json(__('Consultar precio', 'motorlan-portal'))|e('html_attr') }}">{{ __('Consultar precio', 'motorlan-portal')|e }}</button>
      </div>
      {%- endif %}

      <div class="mb-4 flex items-center gap-4">
        {%- if p.seller.avatar %}
          {{ av.avatar({ image: p.seller.avatar, alt: p.seller.name, size: 'lg' }) }}
        {%- else %}
          {{ av.avatar({ text: p.seller.initials, size: 'lg', filled: true }) }}
        {%- endif %}
        <div>
          <p class="font-bold">{{ p.seller.name|e }}</p>
          <p class="text-sm text-medium-emphasis">{{ __('Ventas: %s', 'motorlan-portal')|format(p.seller.sales ?? 0)|e }} | {{ __('Valoraciones: %s', 'motorlan-portal')|format(p.seller.reviews)|e }}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="ml-ficha__bottom">
    {# ── Información (PublicacionInfo.vue) ── #}
    {% include 'partials/ficha/info.twig' %}

    {# ── Documentación (ProductDocs.vue) ── #}
    {% include 'partials/ficha/docs.twig' %}
  </div>

  {# ── Relacionados (RelatedProducts.vue) ── #}
  {%- if related %}
  <section class="mb-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <h2 class="ml-h5 font-bold">{{ __('Productos relacionados', 'motorlan-portal')|e }}</h2>
      <span class="text-sm text-medium-emphasis">{{ __('Otras publicaciones que pueden interesarte', 'motorlan-portal')|e }}</span>
    </div>
    <div class="ml-related">
      {%- for item in related %}
        {% include 'components/product-card.twig' with { item: item, label: __('+ Info', 'motorlan-portal') } only %}
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {% include 'partials/share-dialog.twig' with { title: p.title, url: p.url } only %}
  {%- if p.actions %}
    {% include 'partials/product-chat.twig' with { chat: chat } only %}
  {%- endif %}
</article>
{% endblock %}
