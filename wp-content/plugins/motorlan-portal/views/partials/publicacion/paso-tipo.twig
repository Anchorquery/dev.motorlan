{#
  Paso «Tipo» del alta (StepTypeSelection.vue): cuatro tarjetas; al elegir una se pasa al
  paso siguiente. En la edición el tipo se cambia con un selector en Especificaciones.
  Variables: types · values · mlPubForm (v, pickType, err)
#}
{%- import 'components/icon.twig' as ui -%}
<div class="text-center">
  <h2 class="ml-h5 font-semibold">{{ __('Selecciona el tipo de producto', 'motorlan-portal')|e }}</h2>
  <p class="mt-1 text-medium-emphasis">{{ __('Elige qué tipo de producto quieres añadir a la tienda.', 'motorlan-portal')|e }}</p>
</div>
<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="radiogroup" aria-label="{{ __('Tipo de publicación', 'motorlan-portal')|e('html_attr') }}">
  {%- for key, t in types %}
  <label class="group relative flex cursor-pointer flex-col items-center gap-3 rounded-xl border-2 border-border p-6 text-center transition hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-[color-mix(in_srgb,var(--ml-primary)_6%,transparent)] has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-primary">
    <input type="radio" name="tipo_ui" value="{{ key|e('html_attr') }}" class="sr-only" required x-model="v.tipo_ui" @change="pickType()"{% if values.tipo_ui == key %} checked{% endif %}>
    <span class="grid size-16 place-items-center rounded-full bg-[color-mix(in_srgb,var(--ml-primary)_12%,transparent)] text-primary">{{ ui.icon(t.icon, 'size-9') }}</span>
    <span class="ml-h6 font-semibold">{{ t.title|e }}</span>
    <span class="text-sm text-medium-emphasis">{{ t.description|e }}</span>
  </label>
  {%- endfor %}
</div>
<p class="ml-hint ml-hint--error mt-3 text-center" x-show="err.tipo_ui" x-text="err.tipo_ui" x-cloak></p>
