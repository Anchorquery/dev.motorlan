{#
  Multimedia (StepMedia.vue + DropZone.vue): imagen principal (obligatoria) y galería
  (máx. 5). Con JS: zonas de arrastrar/soltar con previsualización y quitar; las fotos de
  más de 1 MB se reducen a 2000 px (JPEG) antes de enviarlas. Los archivos los añade
  mlPubForm al FormData (los selectores no llevan name). Sin JS: campos de archivo nativos.
  Edición: motor_image_id conserva la imagen actual ('' = quitarla) y gallery_keep[] las de
  la galería que se mantienen.
  Variables: mode · values · form_cfg.maxGallery · mlPubForm (image, gallery, err…)
#}
{%- import 'components/icon.twig' as ui -%}
{%- set max = form_cfg.maxGallery -%}
<h2 class="ml-h6 mb-4 font-semibold">{{ __('Multimedia', 'motorlan-portal')|e }}</h2>

{%- if mode == 'edit' %}
<input type="hidden" name="motor_image_id" value="{{ values.image.id|default('') }}" :value="image && image.id ? image.id : ''">
<template x-for="g in gallery.filter((x) => x.id)" :key="'k' + g.id"><input type="hidden" name="gallery_keep[]" :value="g.id"></template>
{%- endif %}

<div class="grid gap-6 lg:grid-cols-2">
  {# Imagen principal #}
  <div>
    <p class="ml-label">{{ __('Imagen principal', 'motorlan-portal')|e }} <span class="ml-required">*</span></p>
    <div data-js-only>
      <template x-if="image">
        <div class="relative overflow-hidden rounded-xl border border-border">
          <img :src="image.thumb || image.url" alt="" class="aspect-[4/3] w-full object-contain bg-[var(--ml-hover)]">
          <button type="button" class="ml-btn ml-btn--filled ml-btn--icon ml-btn--sm ml-c-error absolute end-2 top-2" @click="removeMain()" aria-label="{{ __('Quitar imagen', 'motorlan-portal')|e('html_attr') }}">{{ ui.icon('trash', 'size-[18px]') }}</button>
          <p class="truncate px-3 py-2 text-xs text-medium-emphasis" x-text="image.name || ''"></p>
        </div>
      </template>
      <label x-show="!image" class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-border px-4 py-10 text-center transition hover:border-primary"
             :class="{ '!border-primary bg-[color-mix(in_srgb,var(--ml-primary)_6%,transparent)]': drag === 'main', '!border-error': err.image }"
             @dragover.prevent="drag = 'main'" @dragleave.prevent="drag = ''" @drop.prevent="drag = ''; addMain($event.dataTransfer.files)">
        <input type="file" accept="image/*" class="sr-only" @change="addMain($event.target.files); $event.target.value = ''">
        <span class="grid size-12 place-items-center rounded-full bg-[color-mix(in_srgb,var(--ml-primary)_12%,transparent)] text-primary">{{ ui.icon('upload', 'size-6') }}</span>
        <span class="font-medium text-high-emphasis">{{ __('Arrastra la imagen aquí o haz clic para elegirla', 'motorlan-portal')|e }}</span>
        <span class="text-xs text-medium-emphasis">{{ __('JPG, PNG, GIF o WebP', 'motorlan-portal')|e }}</span>
      </label>
      <p class="ml-hint ml-hint--error mt-1" x-show="err.image" x-text="err.image" x-cloak></p>
    </div>
    <noscript>
      {%- if values.image %}
      <p class="mb-2 flex items-center gap-3"><img src="{{ values.image.thumb|e('html_attr') }}" alt="" class="size-16 rounded object-cover"><span class="text-sm">{{ __('Imagen actual. Elige otra para sustituirla.', 'motorlan-portal')|e }}</span></p>
      {%- endif %}
      <input type="file" name="motor_image" accept="image/*" class="ml-input"{% if mode == 'add' %} required{% endif %}>
    </noscript>
  </div>

  {# Galería #}
  <div>
    <p class="ml-label">{{ __('Galería de imágenes', 'motorlan-portal')|e }} <span class="text-xs font-normal text-medium-emphasis">({{ __('Máximo %d imágenes', 'motorlan-portal')|format(max)|e }})</span></p>
    <div data-js-only>
      <div class="grid grid-cols-3 gap-3 sm:grid-cols-5 lg:grid-cols-3 xl:grid-cols-5" x-show="gallery.length" x-cloak>
        <template x-for="(g, i) in gallery" :key="g.key">
          <div class="relative overflow-hidden rounded-lg border border-border">
            <img :src="g.thumb || g.url" alt="" class="aspect-square w-full object-cover">
            <button type="button" class="ml-btn ml-btn--filled ml-btn--icon ml-btn--sm ml-c-error absolute end-1 top-1 !size-7" @click="removeGallery(i)" aria-label="{{ __('Quitar imagen', 'motorlan-portal')|e('html_attr') }}">{{ ui.icon('x', 'size-4') }}</button>
          </div>
        </template>
      </div>
      <label x-show="gallery.length < {{ max }}" class="mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-border px-4 py-8 text-center transition hover:border-primary"
             :class="{ '!border-primary bg-[color-mix(in_srgb,var(--ml-primary)_6%,transparent)]': drag === 'gallery' }"
             @dragover.prevent="drag = 'gallery'" @dragleave.prevent="drag = ''" @drop.prevent="drag = ''; addGallery($event.dataTransfer.files)">
        <input type="file" accept="image/*" multiple class="sr-only" @change="addGallery($event.target.files); $event.target.value = ''">
        {{ ui.icon('photo-plus', 'size-7 text-primary') }}
        <span class="text-sm font-medium text-high-emphasis">{{ __('Añadir imágenes a la galería', 'motorlan-portal')|e }}</span>
        <span class="text-xs text-medium-emphasis" x-text="`${gallery.length} / {{ max }}`"></span>
      </label>
      <p class="ml-hint ml-hint--error mt-1" x-show="err.gallery" x-text="err.gallery" x-cloak></p>
    </div>
    <noscript>
      {%- if values.gallery %}
      <div class="mb-2 flex flex-wrap gap-3">
        {%- for g in values.gallery %}
        <label class="flex flex-col items-center gap-1 text-xs"><img src="{{ g.thumb|e('html_attr') }}" alt="" class="size-16 rounded object-cover">
          <span><input type="checkbox" name="gallery_keep[]" value="{{ g.id }}" checked> {{ __('Conservar', 'motorlan-portal')|e }}</span></label>
        {%- endfor %}
      </div>
      {%- endif %}
      <input type="file" name="motor_gallery[]" accept="image/*" multiple class="ml-input">
      <p class="ml-hint">{{ __('Máximo %d imágenes en total.', 'motorlan-portal')|format(max)|e }}</p>
    </noscript>
  </div>
</div>
