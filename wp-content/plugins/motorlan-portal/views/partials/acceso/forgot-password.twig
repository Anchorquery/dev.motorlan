{# Recuperar contraseña (forgot-password.vue). POST -> motorlan/v1/forgot-password. #}
{%- import 'components/field.twig' as fld -%}
{%- import 'components/alert.twig' as al -%}
{%- import 'partials/acceso/_ui.twig' as auth -%}
<div id="ml-auth-body" class="ml-auth-card">
  {{ auth.eyebrow() }}
  <h1 class="ml-auth-card__title">{{ __('¿Olvidaste tu contraseña?', 'motorlan-portal')|e }}</h1>
  <p class="ml-auth-card__subtitle">{{ __('Introduce tu correo y te enviaremos instrucciones para restablecerla.', 'motorlan-portal')|e }}</p>

  {%- if state.done|default(false) %}
  {{ al.alert({ color: 'success', icon: 'check', title: __('¡Enlace enviado!', 'motorlan-portal'),
                text: __('Si el email existe en nuestro sistema, recibirás un enlace para restablecer tu contraseña.', 'motorlan-portal'), class: 'mb-6' }) }}
  {{ auth.back(links.login, __('Volver al login', 'motorlan-portal')) }}
  {%- else %}
  {%- if state.error|default(false) %}{{ al.alert({ color: 'error', icon: 'alert-triangle', text: state.error, class: 'mb-6' }) }}{% endif %}
  <form {{ auth.form_attrs(action) }} class="flex flex-col gap-6">
    {{ auth.hidden(nonce) }}
    {{ fld.text({ name: 'email', type: 'email', label: __('Correo electrónico', 'motorlan-portal'), placeholder: 'tucorreo@email.com',
                  value: state.values.email|default(''), required: true, autocomplete: 'email', attrs: 'autofocus' }) }}
    <button type="submit" class="ml-btn ml-btn--filled ml-c-primary ml-btn--block ml-btn--lg ml-auth-submit">{{ __('Enviar instrucciones', 'motorlan-portal')|e }}</button>
    {{ auth.back(links.login, __('Volver al login', 'motorlan-portal')) }}
  </form>
  {%- endif %}
</div>
