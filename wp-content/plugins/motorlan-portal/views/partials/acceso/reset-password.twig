{#
  Restablecer contraseña (reset-password.vue). El enlace del email llega como
  #key=…&login=… (el servidor mueve los tokens al fragmento): mlAuthToken los copia a los
  campos ocultos y limpia la URL. POST -> motorlan/v1/reset-password.
#}
{%- import 'components/alert.twig' as al -%}
{%- import 'components/icon.twig' as ui -%}
{%- import 'partials/acceso/_ui.twig' as auth -%}
{%- set invalid_text = __('Enlace de restablecimiento inválido. Por favor, solicita uno nuevo.', 'motorlan-portal') -%}
<div id="ml-auth-body" class="ml-auth-card">
  {{ auth.eyebrow() }}
  <h1 class="ml-auth-card__title">{{ __('Restablecer contraseña', 'motorlan-portal')|e }}</h1>
  <p class="ml-auth-card__subtitle">{{ __('Introduce tu nueva contraseña.', 'motorlan-portal')|e }}</p>

  {%- if state.done|default(false) %}
  {{ al.alert({ color: 'success', icon: 'check', title: __('¡Contraseña actualizada!', 'motorlan-portal'),
                text: __('Tu contraseña ha sido restablecida correctamente. Ya puedes iniciar sesión.', 'motorlan-portal'), class: 'mb-6' }) }}
  <div class="text-center"><a href="{{ links.login|e('html_attr') }}" class="ml-btn ml-btn--filled ml-c-primary font-bold">{{ __('Ir al login', 'motorlan-portal')|e }}</a></div>

  {%- else %}
  {%- set invalid = state.invalid|default(false) -%}
  <div x-data="mlAuthToken({ params: ['key', 'login'], required: ['key', 'login'] })">
    {# Enlace inválido: lo decide el servidor (clave caducada) o el navegador (faltan key/login). #}
    <div {% if not invalid %}x-show="missing" x-cloak{% endif %}>
      {{ al.alert({ color: 'error', icon: 'alert-triangle', text: invalid ? state.error : invalid_text, class: 'mb-6' }) }}
      <div class="flex flex-wrap justify-center gap-2">
        <a href="{{ links.forgot|e('html_attr') }}" class="ml-btn ml-btn--filled ml-c-primary font-bold">{{ __('Solicitar un enlace nuevo', 'motorlan-portal')|e }}</a>
        <a href="{{ links.login|e('html_attr') }}" class="ml-btn ml-btn--filled ml-c-primary font-bold">{{ __('Ir al login', 'motorlan-portal')|e }}</a>
      </div>
    </div>

    {%- if not invalid %}
    <div x-show="!missing">
      {%- if state.error|default(false) %}{{ al.alert({ color: 'error', icon: 'alert-triangle', text: state.error, class: 'mb-6' }) }}{% endif %}
      <form {{ auth.form_attrs(action) }} class="flex flex-col gap-6" x-data="mlPassword({{ ml_json({ i18n: { rules: __('La contraseña no cumple los requisitos de seguridad.', 'motorlan-portal'), mismatch: __('Las contraseñas no coinciden.', 'motorlan-portal') } })|e('html_attr') }})" novalidate @submit="guard($event)" @htmx:confirm="guard($event)">
        {{ auth.hidden(nonce) }}
        <input type="hidden" name="key" value="{{ state.key|default('')|e('html_attr') }}" data-token="key">
        <input type="hidden" name="login" value="{{ state.login|default('')|e('html_attr') }}" data-token="login">
        <div>
          {{ auth.password({ name: 'password', label: __('Nueva contraseña', 'motorlan-portal'), autocomplete: 'new-password', model: 'password', autofocus: true,
                             client_error: "touched && !valid ? i18n.rules : ''" }) }}
          <div class="mt-3">{{ auth.requirements() }}</div>
        </div>
        {{ auth.password({ name: 'password_confirm', id: 'password_confirm', label: __('Confirmar contraseña', 'motorlan-portal'), autocomplete: 'new-password', model: 'confirm',
                           client_error: "touched && confirm !== '' && !match ? i18n.mismatch : ''" }) }}
        <button type="submit" class="ml-btn ml-btn--filled ml-c-primary ml-btn--block ml-btn--lg ml-auth-submit">{{ __('Restablecer contraseña', 'motorlan-portal')|e }}</button>
        {{ auth.back(links.login, __('Volver al login', 'motorlan-portal')) }}
      </form>
    </div>
    {%- endif %}
  </div>
  {%- endif %}
</div>
