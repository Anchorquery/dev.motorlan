{#
  Diálogo «Valorar» (components/RatingModal.vue). Lo incluyen Mis compras y el detalle.
  Abrir: $dispatch('ml-rate', { uuid, name, target: 'seller' | 'buyer' }).
  POST a review.url (action=review) con HTMX, sin swap: el servidor responde con el evento
  ml:review en HX-Trigger (mlRating.done). Sin JS, las estrellas son radios y el envío
  recarga la página.
  Variables: review {url, nonce} · refresh (selector del formulario de filtros a recargar)
#}
<div x-data="mlRating({{ ml_json({ dialog: 'ml-rating', refresh: refresh|default(''), i18n: { error: __('Error al enviar la valoración', 'motorlan-portal') } })|e('html_attr') }})"
     class="contents" @ml-rate.window="start($event.detail)" x-on:ml:review.window="done($event)">
  {% embed 'components/dialog.twig' with { id: 'ml-rating', max_width: '500px', persistent: true, review: review } %}
    {% block content %}
    {%- import 'components/icon.twig' as ui -%}
    <form method="post" action="{{ review.url|e('html_attr') }}" hx-post="{{ review.url|e('html_attr') }}" hx-swap="none"
          x-init="window.htmx && window.htmx.process($el)" @submit="busy = true; error = ''"
          @htmx:send-error="busy = false" @htmx:response-error="busy = false">
      <input type="hidden" name="_mlnonce" value="{{ review.nonce|e('html_attr') }}">
      <input type="hidden" name="action" value="review">
      <input type="hidden" name="uuid" :value="uuid">
      <h3 class="ml-h6 mb-5 font-semibold" x-text="target === 'buyer' ? {{ ml_json(__('Valora al comprador', 'motorlan-portal'))|e('html_attr') }} : {{ ml_json(__('Valora al vendedor', 'motorlan-portal'))|e('html_attr') }}">{{ __('Valora al vendedor', 'motorlan-portal')|e }}</h3>

      <div class="mb-6 text-center">
        <p class="mb-2" x-text="name ? {{ ml_json(__('¿Cómo fue tu experiencia con %s?', 'motorlan-portal'))|e('html_attr') }}.replace('%s', name) : {{ ml_json(__('¿Cómo fue tu experiencia?', 'motorlan-portal'))|e('html_attr') }}">{{ __('¿Cómo fue tu experiencia?', 'motorlan-portal')|e }}</p>
        <fieldset class="inline-flex gap-1" @mouseleave="hover = 0">
          <legend class="sr-only">{{ __('Valoración', 'motorlan-portal')|e }}</legend>
          {%- for s in 1..5 %}
          <label class="cursor-pointer rounded-md p-0.5 text-warning focus-within:outline-2 focus-within:outline-warning" @mouseenter="hover = {{ s }}">
            <input type="radio" name="rating" value="{{ s }}" class="sr-only" x-model.number="rating" required>
            <span :class="shown >= {{ s }} ? '[&_svg]:fill-current' : 'opacity-60'">{{ ui.icon('star', 'size-11') }}</span>
            <span class="sr-only">{{ _n('%d estrella', '%d estrellas', s, 'motorlan-portal')|format(s)|e }}</span>
          </label>
          {%- endfor %}
        </fieldset>
        <p class="mt-1 text-xs text-medium-emphasis" x-show="rating > 0" x-cloak x-text="{{ ml_json(__('%d estrellas', 'motorlan-portal'))|e('html_attr') }}.replace('%d', rating)"></p>
      </div>

      <div class="ml-field">
        <label class="ml-label" for="ml-rating-comment">{{ __('Comentario', 'motorlan-portal')|e }} <span class="ml-required">*</span></label>
        <textarea id="ml-rating-comment" name="comment" rows="3" maxlength="1000" required class="ml-input min-h-24"
                  placeholder="{{ __('Cuéntanos tu experiencia', 'motorlan-portal')|e('html_attr') }}" x-model="comment"></textarea>
        <span class="ml-hint flex justify-between"><span>{{ __('Obligatorio', 'motorlan-portal')|e }}</span><span x-text="comment.length + ' / 1000'">0 / 1000</span></span>
      </div>

      <div class="ml-alert ml-c-error mt-4" role="alert" x-show="error" x-cloak>
        <span class="ml-alert__icon">{{ ui.icon('alert-circle') }}</span>
        <div class="ml-alert__body"><div class="ml-alert__text" x-text="error"></div></div>
      </div>

      <div class="mt-6 flex justify-end gap-2">
        <button type="button" class="ml-btn ml-btn--text ml-c-secondary" @click="close()" :disabled="busy">{{ __('Cancelar', 'motorlan-portal')|e }}</button>
        <button type="submit" class="ml-btn ml-btn--filled ml-c-primary px-6" :disabled="!valid || busy" :data-loading="busy.toString()">
          <span>{{ __('Enviar', 'motorlan-portal')|e }}</span>
        </button>
      </div>
    </form>
    {% endblock %}
  {% endembed %}
</div>
