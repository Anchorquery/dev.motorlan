{#
  Tabla de Ofertas enviadas (offers-sent.vue): búsqueda, estado y fechas; acciones ver
  detalle, confirmar compra y retirar. La pintan pages/comprador/ofertas.twig y
  CompradorController (HTMX, también tras confirmar/retirar). Las acciones usan mlOffers
  (x-data de la página): show(o), askWithdraw(o) y send(action, id).
  Variables: table
#}
{% embed 'components/table.twig' with {
  id: 'ml-ofertas',
  url: table.url,
  columns: [
    { label: __('Publicación', 'motorlan-portal') },
    { label: __('Monto ofertado', 'motorlan-portal') },
    { label: __('Fecha', 'motorlan-portal') },
    { label: __('Estado', 'motorlan-portal') },
    { label: __('Acciones', 'motorlan-portal'), class: 'text-end' },
  ],
  page: table.page, pages: table.pages, total: table.total,
  filters_query: table.query,
} %}
  {% block filters %}
    {%- import 'components/field.twig' as f -%}
    {{ f.text({ name: 'q', id: 'ml-ofertas-q', type: 'search', placeholder: __('Buscar oferta...', 'motorlan-portal'), icon: 'search', value: table.filters.q, class: 'w-full md:flex-1 md:max-w-sm' }) }}
    {{ f.select({ name: 'estado', id: 'ml-ofertas-estado', options: table.statuses, value: table.filters.estado, class: 'w-full md:w-56', attrs: 'aria-label="' ~ __('Filtrar por estado', 'motorlan-portal')|e('html_attr') ~ '"' }) }}
    <div class="flex w-full items-end gap-2 md:w-auto">
      {{ f.text({ name: 'desde', id: 'ml-ofertas-desde', type: 'date', label: __('Desde', 'motorlan-portal'), value: table.filters.desde, class: 'flex-1 md:w-40' }) }}
      {{ f.text({ name: 'hasta', id: 'ml-ofertas-hasta', type: 'date', label: __('Hasta', 'motorlan-portal'), value: table.filters.hasta, class: 'flex-1 md:w-40' }) }}
    </div>
    {{ f.select({ name: 'per_page', id: 'ml-ofertas-per-page', options: table.per_page, value: table.filters.per_page, class: 'w-full md:w-44', attrs: 'aria-label="' ~ __('Mostrar', 'motorlan-portal')|e('html_attr') ~ '"' }) }}
    {#- Página actual para confirmar/retirar sin perder la posición (pertenece a #ml-offer-form). #}
    <input type="hidden" name="page" value="{{ table.page|e('html_attr') }}" form="ml-offer-form">
    <noscript><button type="submit" class="ml-btn ml-btn--tonal ml-c-primary">{{ __('Filtrar', 'motorlan-portal')|e }}</button></noscript>
  {% endblock %}
  {% block rows %}
    {%- import 'components/chip.twig' as c -%}
    {%- import 'components/icon.twig' as ui -%}
    {%- for r in table.rows %}
    {%- set o = ml_json(r)|e('html_attr') %}
    <tr data-offer="{{ r.id|e('html_attr') }}" data-status="{{ r.status|e('html_attr') }}">
      <td data-label="{{ __('Publicación', 'motorlan-portal')|e('html_attr') }}">
        {%- if r.url %}
        <a class="block max-w-[250px] truncate font-medium text-high-emphasis hover:text-primary max-md:max-w-none max-md:whitespace-normal" href="{{ r.url|e('html_attr') }}" target="_blank" rel="noopener" title="{{ r.title|e('html_attr') }}">{{ r.title|e }}</a>
        {%- else %}
        <span class="block max-w-[250px] truncate font-medium text-high-emphasis max-md:max-w-none max-md:whitespace-normal" title="{{ r.title|e('html_attr') }}">{{ r.title|e }}</span>
        {%- endif %}
      </td>
      <td data-label="{{ __('Monto ofertado', 'motorlan-portal')|e('html_attr') }}"><span class="font-semibold text-primary">{{ r.amount|e }}</span></td>
      <td data-label="{{ __('Fecha', 'motorlan-portal')|e('html_attr') }}" class="text-high-emphasis"><span title="{{ r.date_full|e('html_attr') }}">{{ r.date|e }}</span></td>
      <td data-label="{{ __('Estado', 'motorlan-portal')|e('html_attr') }}" class="max-md:justify-items-start">{{ c.chip({ label: r.chip.label, color: r.chip.color, size: 'sm' }) }}</td>
      <td class="text-end max-md:!block">
        <div class="inline-flex justify-end gap-1 max-md:hidden">
          <button type="button" class="ml-btn ml-btn--text ml-btn--icon ml-btn--sm ml-c-secondary" title="{{ __('Ver detalle', 'motorlan-portal')|e('html_attr') }}" aria-label="{{ __('Ver detalle', 'motorlan-portal')|e('html_attr') }}" @click="show({{ o }})">{{ ui.icon('eye', 'size-5') }}</button>
          {%- if r.can_confirm %}
          <button type="button" class="ml-btn ml-btn--text ml-btn--icon ml-btn--sm ml-c-success" title="{{ __('Confirmar compra', 'motorlan-portal')|e('html_attr') }}" aria-label="{{ __('Confirmar compra', 'motorlan-portal')|e('html_attr') }}" data-test="offer-confirm"
                  :disabled="busy" @click="send('confirm', {{ r.id }})">{{ ui.icon('check', 'size-5') }}</button>
          {%- endif %}
          {%- if r.can_withdraw %}
          <button type="button" class="ml-btn ml-btn--text ml-btn--icon ml-btn--sm ml-c-error" title="{{ __('Retirar oferta', 'motorlan-portal')|e('html_attr') }}" aria-label="{{ __('Retirar oferta', 'motorlan-portal')|e('html_attr') }}" data-test="offer-withdraw"
                  :disabled="busy" @click="askWithdraw({{ o }})">{{ ui.icon('arrow-back-up', 'size-5') }}</button>
          {%- endif %}
        </div>
        <div class="flex flex-col gap-2 md:hidden">
          <button type="button" class="ml-btn ml-btn--tonal ml-btn--block ml-c-secondary" @click="show({{ o }})">{{ ui.icon('eye', 'size-5') }}<span>{{ __('Ver detalle', 'motorlan-portal')|e }}</span></button>
          {%- if r.can_confirm %}
          <button type="button" class="ml-btn ml-btn--filled ml-btn--block ml-c-success" :disabled="busy" @click="send('confirm', {{ r.id }})">{{ ui.icon('check', 'size-5') }}<span>{{ __('Confirmar compra', 'motorlan-portal')|e }}</span></button>
          {%- endif %}
          {%- if r.can_withdraw %}
          <button type="button" class="ml-btn ml-btn--tonal ml-btn--block ml-c-error" :disabled="busy" @click="askWithdraw({{ o }})">{{ ui.icon('arrow-back-up', 'size-5') }}<span>{{ __('Retirar oferta', 'motorlan-portal')|e }}</span></button>
          {%- endif %}
        </div>
      </td>
    </tr>
    {%- endfor %}
  {% endblock %}
  {% block empty %}
    {%- import 'components/empty.twig' as em -%}
    {%- if table.error %}
      {{ em.empty({ icon: 'alert-circle', title: __('No se pudieron cargar tus ofertas.', 'motorlan-portal'), text: __('Inténtalo de nuevo en unos segundos.', 'motorlan-portal') }) }}
    {%- elseif table.filtered %}
      {{ em.empty({ icon: 'search', title: __('Sin resultados', 'motorlan-portal'), text: __('Prueba con otros filtros.', 'motorlan-portal') }) }}
    {%- else %}
      {{ em.empty({ icon: 'tag', title: __('No has enviado ninguna oferta.', 'motorlan-portal'), text: __('En las publicaciones con precio negociable puedes proponer tu precio al vendedor.', 'motorlan-portal'), action: { label: __('Ir a la tienda', 'motorlan-portal'), href: urls.store, icon: 'building-store' } }) }}
    {%- endif %}
  {% endblock %}
{% endembed %}
