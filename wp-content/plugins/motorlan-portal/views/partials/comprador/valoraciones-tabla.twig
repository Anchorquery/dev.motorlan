{#
  Tabla de Mis valoraciones (opinions.vue): publicación, estrellas y comentario de las
  valoraciones que ha dejado el usuario. La pintan pages/comprador/valoraciones.twig y
  CompradorController (HTMX).
  Variables: table · purchases_url
#}
{% embed 'components/table.twig' with {
  id: 'ml-opiniones',
  url: table.url,
  columns: [
    { label: __('Publicación', 'motorlan-portal') },
    { label: __('Valoración', 'motorlan-portal') },
    { label: __('Comentario', 'motorlan-portal') },
    { label: __('Fecha', 'motorlan-portal') },
  ],
  page: table.page, pages: table.pages, total: table.total,
  filters_query: table.query,
} %}
  {% block filters %}
    {%- import 'components/field.twig' as f -%}
    {{ f.text({ name: 'q', id: 'ml-opiniones-q', type: 'search', placeholder: __('Buscar valoración', 'motorlan-portal'), icon: 'search', value: table.filters.q, class: 'w-full md:flex-1 md:max-w-md' }) }}
    {{ f.select({ name: 'orden', id: 'ml-opiniones-orden', options: table.orders, value: table.filters.orden, class: 'w-full md:w-52', attrs: 'aria-label="' ~ __('Ordenar', 'motorlan-portal')|e('html_attr') ~ '"' }) }}
    {{ f.select({ name: 'per_page', id: 'ml-opiniones-per-page', options: table.per_page, value: table.filters.per_page, class: 'w-full md:w-44', attrs: 'aria-label="' ~ __('Mostrar', 'motorlan-portal')|e('html_attr') ~ '"' }) }}
    <noscript><button type="submit" class="ml-btn ml-btn--tonal ml-c-primary">{{ __('Filtrar', 'motorlan-portal')|e }}</button></noscript>
  {% endblock %}
  {% block rows %}
    {%- import 'components/avatar.twig' as a -%}
    {%- import 'components/icon.twig' as ui -%}
    {%- for r in table.rows %}
    <tr>
      <td data-label="{{ __('Publicación', 'motorlan-portal')|e('html_attr') }}">
        <div class="flex max-w-[340px] items-center gap-3 py-2 max-md:max-w-none">
          {%- if r.image %}{{ a.avatar({ image: r.image, rounded: true, class: '!size-11 shrink-0 border border-border' }) }}{% else %}{{ a.avatar({ icon: 'photo-off', rounded: true, color: 'secondary', class: '!size-11 shrink-0' }) }}{% endif %}
          <div class="min-w-0">
            {%- if r.url %}
            <a class="block truncate font-medium text-high-emphasis hover:text-primary max-md:whitespace-normal" href="{{ r.url|e('html_attr') }}" target="_blank" rel="noopener" title="{{ r.name|e('html_attr') }}">{{ r.name|e }}</a>
            {%- else %}
            <p class="truncate font-medium text-high-emphasis max-md:whitespace-normal" title="{{ r.name|e('html_attr') }}">{{ r.name|e }}</p>
            {%- endif %}
            <p class="text-sm text-medium-emphasis">{{ r.target|e }}{% if r.purchase %} · <a class="hover:text-primary" href="{{ r.purchase|e('html_attr') }}">{{ __('Ver compra', 'motorlan-portal')|e }}</a>{% endif %}</p>
          </div>
        </div>
      </td>
      <td data-label="{{ __('Valoración', 'motorlan-portal')|e('html_attr') }}">
        <span class="inline-flex text-warning" role="img" aria-label="{{ _n('%d estrella', '%d estrellas', r.rating, 'motorlan-portal')|format(r.rating)|e('html_attr') }}">
          {%- for s in 1..5 %}<span class="{{ r.rating >= s ? '[&_svg]:fill-current' : 'opacity-50' }}">{{ ui.icon('star', 'size-[18px]') }}</span>{% endfor -%}
        </span>
      </td>
      <td data-label="{{ __('Comentario', 'motorlan-portal')|e('html_attr') }}">
        <p class="line-clamp-2 max-w-md whitespace-normal text-high-emphasis" title="{{ r.comment|e('html_attr') }}">{{ r.comment|e }}</p>
      </td>
      <td data-label="{{ __('Fecha', 'motorlan-portal')|e('html_attr') }}" class="text-high-emphasis">{{ r.date|e }}</td>
    </tr>
    {%- endfor %}
  {% endblock %}
  {% block empty %}
    {%- import 'components/empty.twig' as em -%}
    {%- if table.error %}
      {{ em.empty({ icon: 'alert-circle', title: __('No se pudieron cargar tus valoraciones.', 'motorlan-portal'), text: __('Inténtalo de nuevo en unos segundos.', 'motorlan-portal') }) }}
    {%- elseif table.filters.q %}
      {{ em.empty({ icon: 'search', title: __('Sin resultados', 'motorlan-portal'), text: __('Prueba con otra búsqueda.', 'motorlan-portal') }) }}
    {%- else %}
      {{ em.empty({ icon: 'star', title: __('Aún no has valorado ninguna compra.', 'motorlan-portal'), text: __('Desde Mis compras puedes valorar al vendedor de cada compra.', 'motorlan-portal'), action: { label: __('Ir a Mis compras', 'motorlan-portal'), href: purchases_url, icon: 'shopping-cart' } }) }}
    {%- endif %}
  {% endblock %}
{% endembed %}
