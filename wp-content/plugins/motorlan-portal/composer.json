{
    "name": "adaki/motorlan-portal",
    "description": "Motorlan — pantallas server-rendered (Timber/Twig + HTMX + Alpine + Tailwind).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "timber/timber": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "MotorlanPortal\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
